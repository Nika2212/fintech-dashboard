{
  "name": "fintech-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "wasm:build": "asc --config wasm/asconfig.json --target release",
    "wasm:build:debug": "asc --config wasm/asconfig.json --target debug",
    "wasm:test": "npm run wasm:build && vitest run --config wasm/vitest.config.mts",
    "wasm:coverage": "npm run wasm:build && vitest run --config wasm/vitest.config.mts --coverage"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@12.1.0",
  "dependencies": {
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@taiga-ui/addon-charts": "^5.29.0",
    "@taiga-ui/addon-commerce": "^5.29.0",
    "@taiga-ui/addon-doc": "^5.29.0",
    "@taiga-ui/addon-mobile": "^5.29.0",
    "@taiga-ui/addon-table": "^5.29.0",
    "@taiga-ui/cdk": "^5.29.0",
    "@taiga-ui/core": "^5.29.0",
    "@taiga-ui/icons": "^5.29.0",
    "@taiga-ui/kit": "^5.29.0",
    "@taiga-ui/layout": "^5.29.0",
    "@taiga-ui/styles": "^5.29.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "assemblyscript": "^0.28.20",
    "jsdom": "^27.1.0",
    "less": "^4.9.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
